<launch>
  <!-- Bridge: /hand_finger_angles  ->  rt/inspire/cmd (Unitree G1 Inspire hands).
       Run this in the environment that has unitree_go + the unitree_ros2 DDS
       bridge sourced (the G1 side). -->

  <arg name="network_interface"   default=""/>
  <arg name="ros_command_topic"   default="/hand_finger_angles"/>
  <arg name="ros_state_topic"     default="/g1_inspire/state"/>
  <!-- Robot's inspire_g1 (raw SDK) listens on native rt/inspire/cmd; from ROS 2 +
       CycloneDDS that is reached by publishing to "inspire/cmd" (rmw adds rt/). -->
  <arg name="dds_cmd_topic"       default="inspire/cmd"/>
  <arg name="dds_state_topic"     default="inspire/state"/>
  <arg name="publish_state"       default="true"/>
  <arg name="command_timeout_sec" default="0.5"/>
  <arg name="safe_open_on_idle"   default="true"/>

  <node pkg="g1_inspire_hand_bridge" exec="g1_inspire_hand_bridge_node"
        name="g1_inspire_hand_bridge_node" output="screen">
    <param name="network_interface"   value="$(var network_interface)"/>
    <param name="ros_command_topic"   value="$(var ros_command_topic)"/>
    <param name="ros_state_topic"     value="$(var ros_state_topic)"/>
    <param name="dds_cmd_topic"       value="$(var dds_cmd_topic)"/>
    <param name="dds_state_topic"     value="$(var dds_state_topic)"/>
    <param name="publish_state"       value="$(var publish_state)"/>
    <param name="command_timeout_sec" value="$(var command_timeout_sec)"/>
    <param name="safe_open_on_idle"   value="$(var safe_open_on_idle)"/>
  </node>
</launch>
